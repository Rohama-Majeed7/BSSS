# Neon PostgreSQL Connection URLs
# Replace with your actual Neon database credentials:
# DATABASE_URL: Pooled connection string (with ?sslmode=require)
DATABASE_URL="postgresql://postgres:Admin@123@localhost:5432/bright_stars_school?schema=public"

# DIRECT_URL: Direct unpooled connection string (required by Prisma migrations)
# DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/bss_sms?sslmode=require"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-change-this-in-production-123456789"
